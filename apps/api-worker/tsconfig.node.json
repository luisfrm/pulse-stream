{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    // Scripts de tooling (drizzle-kit, migrador): corren en Node, no en Workers.
    "lib": ["ES2022"],
    "types": ["node"],
    // Los scripts reusan módulos de `src/` (auth, repos), que importan con `@/`.
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["drizzle.config.ts", "vitest.config.ts", "scripts/**/*.ts"]
}
