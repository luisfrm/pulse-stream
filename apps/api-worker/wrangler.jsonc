{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulse-stream-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "dev": {
    // 8787: el puerto que espera el web (`NEXT_PUBLIC_API_URL` de
    // apps/web/.env.local). El backend Python (uvicorn, :8000) es la
    // implementación de referencia y ya no corre en el flujo del monorepo.
    "port": 8787
  },
  // Los secretos viven en .dev.vars (local) y en `wrangler secret put` (prod).
  // No agregar vars sensibles acá: este archivo se commitea.
  "vars": {}
}
