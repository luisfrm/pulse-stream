# Copiar a `.dev.vars` (gitignored) para `wrangler dev`.
# NUNCA commitear valores reales.

# Obligatorio. HS256: usar al menos 32 caracteres aleatorios.
AUTH_SECRET=replace-with-a-long-random-development-secret

# Conexión directa a Neon (sin -pooler). El Worker usa el driver HTTP de Neon
# tanto en local como en producción.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# R2 (opcional en local; sin las 4 credenciales el presign de covers da 503).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
