{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pulse-stream-app-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  "observability": {
    "enabled": true
  },
  // Mismo driver de DB en local y producción: Neon HTTP (`DATABASE_URL`).
  // Secrets (NO commitear): `wrangler secret put <NAME>`.
  //   AUTH_SECRET       HS256 para `session` (>= 32 chars)
  //   DATABASE_URL      conexión directa a Neon (sin -pooler)
  //   R2_*              credenciales de firmado de covers
  // En local se cargan desde `.dev.vars` (ver `.dev.vars.example`).
  "vars": {
    "ENV": "local",
    "APP_URL": "http://localhost:3000",
    "COOKIE_DOMAIN": "",
    "CORS_ORIGINS": "http://localhost:3000",
    "R2_PUBLIC_BASE_URL": ""
  },
  "env": {
    "prod": {
      "vars": {
        "ENV": "prod",
        "APP_URL": "https://pulse-stream.luisrivas.site",
        "COOKIE_DOMAIN": "luisrivas.site",
        "CORS_ORIGINS": "https://pulse-stream.luisrivas.site",
        // Reemplazar por el dominio público real del bucket R2.
        "R2_PUBLIC_BASE_URL": "https://REPLACE_WITH_R2_PUBLIC_BASE_URL"
      },
      "routes": [
        {
          "pattern": "api.luisrivas.site",
          "custom_domain": true
        }
      ],
      "workers_dev": false
    }
  }
}
