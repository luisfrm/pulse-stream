{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pulse-stream-app-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Secrets (NO commitear): `wrangler secret put <NAME>`
  //   AUTH_SECRET            HS256 para `session` y `oauth_state` (>= 32 chars)
  //   GOOGLE_CLIENT_ID       OAuth client de Google Cloud Console
  //   GOOGLE_CLIENT_SECRET   idem
  //   GOOGLE_REDIRECT_URI    debe coincidir con el Authorized redirect URI
  // En local se cargan desde `.dev.vars` (ver `.dev.vars.example`).
  "vars": {
    "ENV": "local",
    "APP_URL": "http://localhost:3000",
    "COOKIE_DOMAIN": "",
    "CORS_ORIGINS": "http://localhost:3000",
    "R2_PUBLIC_BASE_URL": ""
  },
  // Reemplazar por el id real (`wrangler hyperdrive create ...`).
  // Sin Hyperdrive local, `db/client.ts` cae a `DATABASE_URL` (solo si el
  // binding no existe: para `wrangler dev` sin Hyperdrive, comentá este bloque).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_ID"
    }
  ]
}
