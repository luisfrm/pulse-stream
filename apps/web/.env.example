# URL base de la API (Cloudflare Worker en prod, worker local en dev).
# `NEXT_PUBLIC_*` se inlinea en build: cambiarla exige redeploy.
NEXT_PUBLIC_API_URL=http://localhost:8787

# Entorno del server del web. Decide si la cookie de logout va con `Secure`
# (ENV != local) y qué SameSite usa. En Vercel: ENV=prod.
ENV=local

# Dominio de la cookie de sesión. Debe coincidir con el del Worker para que el
# borrado del logout matchee. En prod con subdominios: el dominio registrable.
# COOKIE_DOMAIN=example.com

# lax (default) | none (solo si el web y la API están en dominios distintos).
# COOKIE_SAMESITE=lax
