# URL base de la API Hono de la app (`apps/app-api`). La usa el navegador
# (client components), el servidor Next (server components / proxy) y el link
# de "Continuar con Google".
# Local: http://localhost:8787 · Prod: https://api.luisrivas.site
NEXT_PUBLIC_API_URL=http://localhost:8787

# Cookie HttpOnly que emite Hono y que reenvía el api-client (default: session).
# SESSION_COOKIE=session

# Atributos de la cookie `session` — deben reflejar los del backend Hono para
# que el route handler /api/logout pueda borrarla:
#   ENV != local  -> la cookie lleva Secure (el Set-Cookie de borrado también)
#   COOKIE_DOMAIN -> dominio registrable compartido entre subdominios
#   COOKIE_SAMESITE -> lax | strict | none (default lax)
# En prod (web y API en subdominios de luisrivas.site):
#   ENV=prod
#   COOKIE_DOMAIN=luisrivas.site
# ENV=local
# COOKIE_DOMAIN=
# COOKIE_SAMESITE=lax
