# Entorno: local (default) | dev | prod
# local  -> cookies sin Secure, SameSite=lax, Swagger habilitado
# dev/prod -> cookies Secure, Swagger deshabilitado
ENV=local

# Secreto para firmar los JWT de sesión (usá un valor largo y aleatorio).
# Generá uno con: python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_SECRET=change-me-generate-a-long-random-secret

# Conexión a Neon — SIEMPRE la variante POOLED (host con -pooler, via PgBouncer)
# para las queries de la app.
# Copiala tal cual la da Neon (postgresql://...): el código la normaliza a
# postgresql+asyncpg:// automáticamente.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/dbname?sslmode=require

# Conexión DIRECTA de Neon (sin -pooler) — SOLO para migraciones de Alembic.
# Si no la definís, Alembic usa DATABASE_URL (funciona, pero en prod preferí la directa).
DATABASE_URL_DIRECT=

# Regex de orígenes permitidos para CORS con credenciales (cookies).
# Por defecto: cualquier subdominio de tudominio.com + localhost en cualquier puerto.
# En prod: https://([a-zA-Z0-9-]+\.)?luisrivas\.site|http://localhost:\d+
CORS_ORIGIN_REGEX=https://([a-zA-Z0-9-]+\.)?tudominio\.com|http://localhost:\d+

# SameSite de la cookie de sesión (default: lax).
# - lax: local (localhost) y prod con subdominios del mismo dominio (same-site,
#   ej. front en pulse-stream.luisrivas.site + API en pulse-stream-api.luisrivas.site).
# - none: SOLO si front y API viven en dominios completamente distintos
#   (cross-site real) — exige HTTPS (ENV=prod lo asegura con Secure=True).
# COOKIE_SAMESITE=lax

# Dominio de la cookie de sesión. En local NO se setea (localhost se comparte
# entre puertos). En prod con subdominios, seteá el dominio registrable para
# que la cookie viaje a todos los subdominios (el guard del front la necesita
# en su propio dominio; sin esto el login bucla en /login?next=...):
# COOKIE_DOMAIN=luisrivas.site

# --- Cloudflare R2 (Fase 1 — subida de canciones con presigned URLs) ---
# 1. Creá un bucket en Cloudflare R2 (Dashboard > R2 > Create bucket).
# 2. Generá un API Token con permiso "Object Read & Write" (Dashboard > R2 >
#    Manage R2 API Tokens) y copiá el Access Key ID + Secret Access Key.
# 3. Completá las 4 variables de abajo.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Dominio público del bucket (R2 > Settings > Custom Domain). Habilita
# `stream_url` en SongRead para reproducir las canciones sin autenticación.
R2_PUBLIC_BASE_URL=
# Tamaño máximo de subida en bytes (default: 50 MB)
# R2_MAX_UPLOAD_BYTES=52428800
