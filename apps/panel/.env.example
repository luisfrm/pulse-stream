# URL base de la API de administración (FastAPI local). El panel NO se
# despliega: corre contra `apps/api` en :8000 (la app usa Hono en :8787).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cookie de sesión del panel. Debe coincidir con `SESSION_COOKIE_NAME` del
# Python local (`panel_session`) para no compartir la cookie `session` de Hono
# en localhost.
PANEL_SESSION_COOKIE=panel_session

# URL de la app (links de "Mi cuenta" y "ver playlist"). El panel no tiene esas
# páginas: la app corre en :3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Espejo del backend para el Set-Cookie del logout (ENV, COOKIE_DOMAIN,
# COOKIE_SAMESITE). En local, vacíos.
# ENV=local
# COOKIE_DOMAIN=
# COOKIE_SAMESITE=lax
