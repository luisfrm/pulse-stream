# URL base de la API de administración. En Fase 1 apunta a la API Python
# local; en Fase 4 al Worker de Hono.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cookie de sesión del panel. En Fase 1 debe ser `session` (la que setea
# Python); en Fase 4 cambia a `panel_session` cuando Hono emita una cookie
# separada para el panel.
PANEL_SESSION_COOKIE=session

# URL de la app (links de "Mi cuenta" y "ver playlist"). El panel no tiene esas
# páginas: en Fase 1 la app corre en :3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Espejo del backend para el Set-Cookie del logout (ENV, COOKIE_DOMAIN,
# COOKIE_SAMESITE). En local, vacíos.
# ENV=local
# COOKIE_DOMAIN=
# COOKIE_SAMESITE=lax
